# 数据库地址
MONGODB_URI=mongodb://username:password@127.0.0.1:27017/nest_serve_db?authSource=admin

# 对登录密码进行加密的密钥（必填，缺失会拒绝启动）
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 注意：换新值会让库存密码散列全部失效，已有账号将无法登录
PASSWORD_KEY=your_password_key_here

# jwt密钥（必填，缺失会拒绝启动；换新值会让已签发的 token 全部失效，用户需重新登录）
# 生成方式同上
JWT_SECRET=your_jwt_secret_here

# 向量数据库
MILVUS_ADDRESS=127.0.0.1:19530

# Qwen的API_KEY（仅用于 embedding，DeepSeek 不提供向量化 API）
QWEN_API_KEY=sk-your_qwen_api_key_here

# embedding模型名称
QWEN_EMBEDDING_MODEL=text-embedding-v3

# embedding维度（通义千问 text-embedding-v3 仅支持 64/128/256/512/768/1024）
QWEN_EMBEDDING_DIMENSIONS=1024

# redis地址
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# DeepSeek Api（对话生成 + 图片理解 + 关键词提取，deepseek-flash 自带多模态）
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 图片访问域名
IMAGE_BASE_URL_local=http://localhost:3000/open-image

# 服务端口
PORT=3000
